# Native HTTPS or a trusted HTTPS reverse proxy
PUBLIC_URL=https://skills.example.com/mcp
HOST=127.0.0.1
PORT=8080
TRUST_PROXY=0
# TLS_CERT=/absolute/path/fullchain.pem
# TLS_KEY=/absolute/path/privkey.pem

# Inject DATABASE_URL from a secret manager, or use these PG settings and a
# mounted secret file. Do not commit database passwords or agent tokens.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=skillgesture
PGDATABASE=skillgesture
DATABASE_PASSWORD_FILE=/absolute/path/database-password

# Exact dashboard origins, e.g. http://127.0.0.1:5173 or https://console.example.com.
# Native MCP clients do not need CORS. Restart the server after changes.
ALLOWED_ORIGINS=
SKILLGESTURE_STRUCTURED_OUTPUT=0

# Compose deployment uses these values:
# SKILLGESTURE_DOMAIN=skills.example.com
# SKILLGESTURE_DB_PASSWORD_FILE=/absolute/path/database-password
